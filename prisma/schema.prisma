// Esquema de la API del congreso CIISIC.
// Convención (specs/001-esquema-bd-espanol/data-model.md): tablas en español, snake_case y plural;
// modelos singulares en PascalCase mapeados con @@map / @map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ─── Administración ──────────────────────────────────────────────────────────

model Rol {
  id              Int             @id @default(autoincrement())
  codigo          String          @unique(map: "uq_roles_codigo") @db.VarChar(30)
  nombre          String
  administradores Administrador[]

  @@map("roles")
}

model Administrador {
  id                               Int                    @id @default(autoincrement())
  nombres                          String
  apellidos                        String
  correo                           String                 @unique(map: "uq_administradores_correo")
  // Sin contraseña (NULL) el administrador entra solo con Google
  contrasenaHash                   String?                @map("contrasena_hash")
  creadoEn                         DateTime               @default(now()) @map("creado_en")
  actualizadoEn                    DateTime               @updatedAt @map("actualizado_en")
  rolId                            Int                    @map("rol_id")
  activo                           Boolean                @default(true)
  googleSub                        String?                @unique(map: "uq_administradores_google_sub") @map("google_sub") @db.VarChar(255)
  googleVinculadoEn                DateTime?              @map("google_vinculado_en")
  rol                              Rol                    @relation(fields: [rolId], references: [id], map: "fk_administradores_rol")
  inscripcionesRevisadas           Inscripcion[]          @relation("InscripcionRevisor")
  pagosDelegacionRevisados         DelegacionPago[]       @relation("DelegacionPagoRevisor")
  tokensAccesoCreados              TokenAcceso[]
  configuracionesEditadas          ConfiguracionSistema[]
  asignacionesEvento               AsignacionEvento[]
  permisos                         PermisoAdministrador[]
  asistenciasRegistradas           Asistencia[]           @relation("AsistenciaRegistradaPor")
  asistenciasAnuladas              Asistencia[]           @relation("AsistenciaAnuladaPor")
  inscripcionesPonenciaRegistradas InscripcionPonencia[]  @relation("InscripcionPonenciaRegistradaPor")
  asistenciasPonenciaRegistradas   InscripcionPonencia[]  @relation("InscripcionPonenciaAsistenciaPor")
  cambiosTipoRealizados            CambioTipoInscripcion[] @relation("CambioTipoRealizadoPor")
  kitsEntregados                   Inscripcion[]          @relation("InscripcionKitEntregadoPor")

  @@index([rolId], map: "idx_administradores_rol")
  @@map("administradores")
}

/// Eventos de una cuenta con alcance por evento (Tesorero, Comisión). Spec 013.
model AsignacionEvento {
  administradorId Int           @map("administrador_id")
  eventoId        Int           @map("evento_id")
  creadoEn        DateTime      @default(now()) @map("creado_en")
  administrador   Administrador @relation(fields: [administradorId], references: [id], onDelete: Cascade, map: "fk_asignaciones_evento_administrador")
  evento          Evento        @relation(fields: [eventoId], references: [id], onDelete: Cascade, map: "fk_asignaciones_evento_evento")

  @@id([administradorId, eventoId])
  @@index([eventoId], map: "idx_asignaciones_evento_evento")
  @@map("asignaciones_evento")
}

/// Permisos elegidos para una cuenta de la Comisión (códigos de src/core/permisos.ts). Spec 013.
model PermisoAdministrador {
  administradorId Int           @map("administrador_id")
  permiso         String        @db.VarChar(60)
  creadoEn        DateTime      @default(now()) @map("creado_en")
  administrador   Administrador @relation(fields: [administradorId], references: [id], onDelete: Cascade, map: "fk_permisos_administrador_administrador")

  @@id([administradorId, permiso])
  @@map("permisos_administrador")
}

// ─── Eventos ─────────────────────────────────────────────────────────────────

enum EstadoEvento {
  BORRADOR
  PUBLICADO
  FINALIZADO
  ARCHIVADO
}

model Evento {
  id                      Int                     @id @default(autoincrement())
  codigo                  String                  @unique(map: "uq_eventos_codigo") @db.VarChar(60)
  nombre                  String                  @db.VarChar(200)
  nombreCorto             String                  @map("nombre_corto") @db.VarChar(80)
  descripcion             String?                 @db.Text
  sede                    String?                 @db.VarChar(200)
  fechaInicio             DateTime                @map("fecha_inicio") @db.Date
  fechaFin                DateTime                @map("fecha_fin") @db.Date
  inscripcionesInicio     DateTime?               @map("inscripciones_inicio")
  inscripcionesFin        DateTime?               @map("inscripciones_fin")
  inscripcionesAbiertas   Boolean                 @default(true) @map("inscripciones_abiertas")
  estado                  EstadoEvento            @default(BORRADOR)
  esPrincipal             Boolean                 @default(false) @map("es_principal")
  dominioInstitucional    String                  @default("undc.edu.pe") @map("dominio_institucional") @db.VarChar(100)
  correoContacto          String?                 @map("correo_contacto")
  telefonoContacto        String?                 @map("telefono_contacto") @db.VarChar(30)
  remitenteNombre         String?                 @map("remitente_nombre") @db.VarChar(120)
  asuntoAprobacion        String?                 @map("asunto_aprobacion") @db.VarChar(200)
  logoArchivo             String?                 @map("logo_archivo") @db.VarChar(255)
  datosPago               Json?                   @map("datos_pago")
  credencialCorreoId      Int?                    @map("credencial_correo_id")
  /// Ponencias especializadas (spec 030): encendido, cualquiera se inscribe solo con su documento; apagado
  /// (por defecto), solo quien tiene una inscripción aprobada al congreso.
  ponenciasAccesoLibre    Boolean                 @default(false) @map("ponencias_acceso_libre")
  creadoEn                DateTime                @default(now()) @map("creado_en")
  actualizadoEn           DateTime                @updatedAt @map("actualizado_en")
  credencialCorreo        CredencialCorreo?       @relation(fields: [credencialCorreoId], references: [id], onDelete: SetNull, map: "fk_eventos_credencial_correo")
  categorias              CategoriaInscripcion[]
  inscripciones           Inscripcion[]
  actividades             Actividad[]
  ponencias               Ponencia[]
  ponenciasEspecializadas PonenciaEspecializada[]
  mensajesContacto        MensajeContacto[]
  integraciones           IntegracionEvento[]
  tokensAcceso            TokenAcceso[]
  asignaciones            AsignacionEvento[]
  delegaciones            Delegacion[]
  asesores                Asesor[]
  padronEstudiantes       PadronEstudiante[]
  padronCursos            PadronCurso[]
  enlacesCiclo            EnlaceCiclo[]
  enlaceAforoPonencias    EnlaceAforoPonencias?

  @@index([credencialCorreoId], map: "idx_eventos_credencial_correo")
  @@map("eventos")
}

// ─── Participantes e inscripciones ───────────────────────────────────────────

model TipoDocumento {
  id                 String              @id
  nombre             String
  abreviatura        String              @unique(map: "uq_tipos_documento_abreviatura")
  participantes      Participante[]
  asistentesPonencia AsistentePonencia[]

  @@map("tipos_documento")
}

model Participante {
  id                Int            @id @default(autoincrement())
  tipoDocumentoId   String         @map("tipo_documento_id")
  numeroDocumento   String         @map("numero_documento") @db.VarChar(20)
  nombres           String
  apellidos         String
  correo            String         @unique(map: "uq_participantes_correo")
  celular           String         @db.VarChar(20)
  googleSub         String?        @unique(map: "uq_participantes_google_sub") @map("google_sub") @db.VarChar(255)
  googleVinculadoEn DateTime?      @map("google_vinculado_en")
  /// Foto opcional del fotocheck (spec 014): `foto-<uuid>.(png|jpg)` en uploads/fotos, sin metadatos
  fotoArchivo       String?        @map("foto_archivo") @db.VarChar(80)
  fotoActualizadaEn DateTime?      @map("foto_actualizada_en")
  creadoEn          DateTime       @default(now()) @map("creado_en")
  actualizadoEn     DateTime       @updatedAt @map("actualizado_en")
  tipoDocumento     TipoDocumento  @relation(fields: [tipoDocumentoId], references: [id], map: "fk_participantes_tipo_documento")
  inscripciones     Inscripcion[]
  asistencias       Asistencia[]
  codigosAcceso     CodigoAcceso[]

  @@unique([tipoDocumentoId, numeroDocumento], map: "uq_participantes_documento")
  @@map("participantes")
}

/// Código de acceso al portal enviado por correo (spec 014). Solo se guarda su HMAC-SHA256
/// (clave derivada de JWT_SECRET). `participanteId` NULL: el correo no corresponde a nadie.
model CodigoAcceso {
  id             Int           @id @default(autoincrement())
  correo         String        @db.VarChar(191)
  codigoHash     String        @map("codigo_hash") @db.Char(64)
  participanteId Int?          @map("participante_id")
  ip             String?       @db.VarChar(45)
  intentos       Int           @default(0)
  expiraEn       DateTime      @map("expira_en")
  usadoEn        DateTime?     @map("usado_en")
  invalidadoEn   DateTime?     @map("invalidado_en")
  creadoEn       DateTime      @default(now()) @map("creado_en")
  participante   Participante? @relation(fields: [participanteId], references: [id], onDelete: Cascade, map: "fk_codigos_acceso_participante")

  @@index([correo, creadoEn], map: "idx_codigos_acceso_correo_creado")
  @@index([ip, creadoEn], map: "idx_codigos_acceso_ip_creado")
  @@index([participanteId], map: "idx_codigos_acceso_participante")
  @@index([creadoEn], map: "idx_codigos_acceso_creado")
  @@map("codigos_acceso")
}

model CategoriaInscripcion {
  id              Int               @id @default(autoincrement())
  eventoId        Int               @map("evento_id")
  codigo          String            @db.VarChar(40)
  nombre          String
  descripcion     String?
  caracteristicas Json?
  precioDesde     Decimal?          @map("precio_desde") @db.Decimal(10, 2)
  esEstudiantil   Boolean           @default(false) @map("es_estudiantil")
  orden           Int               @default(0)
  /// Spec 029: categoría oculta de una delegación (`DELEGACION_<id>`) con sus planes Con kit, Sin kit y Virtual.
  /// No sale en Categorías y tipos ni en la landing; se administra desde Delegaciones.
  delegacionId    Int?              @unique(map: "uq_categorias_inscripcion_delegacion") @map("delegacion_id")
  evento          Evento            @relation(fields: [eventoId], references: [id], map: "fk_categorias_inscripcion_evento")
  delegacion      Delegacion?       @relation("PlanesDeDelegacion", fields: [delegacionId], references: [id], onDelete: SetNull, map: "fk_categorias_inscripcion_delegacion")
  tipos           TipoInscripcion[]

  @@unique([eventoId, codigo], map: "uq_categorias_inscripcion_evento_codigo")
  @@map("categorias_inscripcion")
}

model TipoInscripcion {
  id                     Int                  @id @default(autoincrement())
  categoriaId            Int                  @map("categoria_id")
  codigo                 String               @db.VarChar(80)
  nombre                 String
  etiqueta               String?
  descripcion            String?              @db.Text
  caracteristicas        Json?
  precio                 Decimal              @db.Decimal(10, 2)
  precioInstitucional    Decimal              @map("precio_institucional") @db.Decimal(10, 2)
  /// Spec 029: solo los planes de una delegación. Desde `minIntegrantes` de la delegación el plan cobra este precio.
  precioPromocional      Decimal?             @map("precio_promocional") @db.Decimal(10, 2)
  disponiblePara         DisponibilidadTipo   @default(TODOS) @map("disponible_para")
  modalidad              ModalidadAsistencia  @default(PRESENCIAL) @map("modalidad")
  /// Spec 037: el tipo incluye el kit de merchandising (se entrega en la puerta). Un tipo virtual nunca lo incluye.
  incluyeKit             Boolean              @default(false) @map("incluye_kit")
  /// Spec 020: no se ofrece a estudiantes de la UNDC (verificados o con correo institucional numérico).
  excluyeEstudiantesUndc Boolean              @default(false) @map("excluye_estudiantes_undc")
  activo                 Boolean              @default(true)
  orden                  Int                  @default(0)
  categoria              CategoriaInscripcion @relation(fields: [categoriaId], references: [id], map: "fk_tipos_inscripcion_categoria")
  inscripciones          Inscripcion[]

  @@unique([categoriaId, codigo], map: "uq_tipos_inscripcion_categoria_codigo")
  @@map("tipos_inscripcion")
}

/// A quién se ofrece un tipo de inscripción (spec 016). «Institucional» es la misma condición que da
/// el precio institucional: estudiante UNDC verificado (categoría estudiantil) o correo del dominio.
enum DisponibilidadTipo {
  TODOS
  INSTITUCIONAL
  EXTERNOS
}

/// Cómo se asiste al evento con un tipo de inscripción (spec 018). No es la modalidad de pago
/// (`Inscripcion.modalidadPago`: banco, billetera, cortesía), que es otra cosa.
enum ModalidadAsistencia {
  PRESENCIAL
  VIRTUAL
}

model Clasificacion {
  id            Int           @id @default(autoincrement())
  nombre        String
  inscripciones Inscripcion[]

  @@map("clasificaciones")
}

model EstadoInscripcion {
  id            Int           @id @default(autoincrement())
  codigo        String        @unique(map: "uq_estados_inscripcion_codigo") @db.VarChar(30)
  nombre        String        @unique(map: "uq_estados_inscripcion_nombre")
  inscripciones Inscripcion[]

  @@map("estados_inscripcion")
}

model Inscripcion {
  id                     Int               @id @default(autoincrement())
  eventoId               Int               @map("evento_id")
  participanteId         Int               @map("participante_id")
  delegacionId           Int?              @map("delegacion_id")
  tipoInscripcionId      Int?              @map("tipo_inscripcion_id")
  clasificacionId        Int?              @map("clasificacion_id")
  estadoId               Int               @map("estado_id")
  creadoEn               DateTime          @default(now()) @map("creado_en")
  actualizadoEn          DateTime          @updatedAt @map("actualizado_en")
  banco                  String?
  billeteraDigital       String?           @map("billetera_digital")
  descuento              Decimal           @default(0) @db.Decimal(10, 2)
  esCorreoInstitucional  Boolean           @default(false) @map("es_correo_institucional")
  fechaPago              DateTime          @map("fecha_pago")
  voucherArchivo         String?           @map("voucher_archivo")
  tieneDescuento         Boolean           @default(false) @map("tiene_descuento")
  modalidadPago          String?           @map("modalidad_pago")
  numeroOperacion        String            @unique(map: "uq_inscripciones_numero_operacion") @map("numero_operacion")
  monto                  Decimal           @db.Decimal(10, 2)
  tipoOperacion          String?           @map("tipo_operacion")
  motivoRechazo          String?           @map("motivo_rechazo") @db.VarChar(500)
  revisadoPorId          Int?              @map("revisado_por_id")
  revisadoEn             DateTime?         @map("revisado_en")
  credencialEnviadaEn    DateTime?         @map("credencial_enviada_en")
  /// Spec 039: último envío masivo del enlace de la credencial 3D (`<landing>/credencial/<codigo>`).
  enlaceCredencialEnviadoEn DateTime?      @map("enlace_credencial_enviado_en")
  /// Spec 039: último envío masivo del enlace para inscribirse a las ponencias especializadas.
  enlacePonenciasEnviadoEn  DateTime?      @map("enlace_ponencias_enviado_en")
  /// Spec 038: ids de las tecnologías que la persona eligió para su credencial 3D (máx. 8; el catálogo vive en la landing).
  tecnologiasCredencial  Json?             @map("tecnologias_credencial")
  esEstudianteUndc       Boolean           @default(false) @map("es_estudiante_undc")
  codigoEstudiante       String?           @map("codigo_estudiante") @db.VarChar(20)
  verificacionEstudiante Json?             @map("verificacion_estudiante")
  esCorreoVerificado     Boolean           @default(false) @map("es_correo_verificado")
  verificacionCorreo     Json?             @map("verificacion_correo")
  /// Código aleatorio del QR del fotocheck (spec 014): 10 caracteres base 36 en mayúsculas.
  /// Admite NULL para convivir con la imagen anterior; `asegurarCodigoCredencial` lo completa.
  codigoCredencial       String?           @unique(map: "uq_inscripciones_codigo_credencial") @map("codigo_credencial") @db.Char(10)
  /// Pudo recibir la credencial con el QR anterior (id del participante): ese QR se acepta con aviso.
  esQrLegado             Boolean           @default(false) @map("es_qr_legado")
  /// Spec 037: cuándo y quién entregó el kit (una persona recibe uno por congreso). `NULL` = aún no se entrega; deshacer la entrega las limpia.
  kitEntregadoEn         DateTime?         @map("kit_entregado_en")
  kitEntregadoPorId      Int?              @map("kit_entregado_por_id")
  evento                 Evento            @relation(fields: [eventoId], references: [id], map: "fk_inscripciones_evento")
  participante           Participante      @relation(fields: [participanteId], references: [id], map: "fk_inscripciones_participante")
  delegacion             Delegacion?        @relation(fields: [delegacionId], references: [id], onDelete: SetNull, map: "fk_inscripciones_delegacion")
  tipoInscripcion        TipoInscripcion?  @relation(fields: [tipoInscripcionId], references: [id], onDelete: SetNull, map: "fk_inscripciones_tipo_inscripcion")
  clasificacion          Clasificacion?    @relation(fields: [clasificacionId], references: [id], onDelete: SetNull, map: "fk_inscripciones_clasificacion")
  estado                 EstadoInscripcion @relation(fields: [estadoId], references: [id], map: "fk_inscripciones_estado")
  revisadoPor            Administrador?    @relation("InscripcionRevisor", fields: [revisadoPorId], references: [id], onDelete: SetNull, map: "fk_inscripciones_revisado_por")
  kitEntregadoPor        Administrador?    @relation("InscripcionKitEntregadoPor", fields: [kitEntregadoPorId], references: [id], onDelete: SetNull, map: "fk_inscripciones_kit_entregado_por")
  inscripcionesPonencia  InscripcionPonencia[]
  cambiosTipo            CambioTipoInscripcion[]

  @@unique([eventoId, participanteId], map: "uq_inscripciones_evento_participante")
  @@index([participanteId], map: "idx_inscripciones_participante")
  @@index([delegacionId], map: "idx_inscripciones_delegacion")
  @@index([tipoInscripcionId], map: "idx_inscripciones_tipo_inscripcion")
  @@index([clasificacionId], map: "idx_inscripciones_clasificacion")
  @@index([estadoId], map: "idx_inscripciones_estado")
  @@index([revisadoPorId], map: "idx_inscripciones_revisado_por")
  @@index([kitEntregadoPorId], map: "idx_inscripciones_kit_entregado_por")
  @@map("inscripciones")
}

/// Corrección del tipo de una inscripción hecha por el Owner (spec 035). Guarda el texto de ambos tipos para que el
/// historial se lea aunque después se renombre o se borre un tipo. Se borra junto con la inscripción.
model CambioTipoInscripcion {
  id             Int            @id @default(autoincrement())
  inscripcionId  Int            @map("inscripcion_id")
  /// «Tipo · etiqueta» antes del cambio; «Sin tipo» si no tenía (cortesía).
  anterior       String         @db.VarChar(400)
  /// «Tipo · etiqueta» después del cambio.
  nuevo          String         @db.VarChar(400)
  /// Por qué se corrigió (opcional).
  motivo         String?        @db.VarChar(500)
  realizadoPorId Int?           @map("realizado_por_id")
  creadoEn       DateTime       @default(now()) @map("creado_en")
  inscripcion    Inscripcion    @relation(fields: [inscripcionId], references: [id], onDelete: Cascade, map: "fk_cambios_tipo_inscripcion")
  realizadoPor   Administrador? @relation("CambioTipoRealizadoPor", fields: [realizadoPorId], references: [id], onDelete: SetNull, map: "fk_cambios_tipo_realizado_por")

  @@index([inscripcionId, creadoEn], map: "idx_cambios_tipo_inscripcion")
  @@index([realizadoPorId], map: "idx_cambios_tipo_realizado_por")
  @@map("cambios_tipo_inscripcion")
}

/// Delegación o institución que inscribe a su grupo. Tiene sus propios planes (Con kit, Sin kit y Virtual): son
/// tipos de inscripción de su categoría oculta (`planes`), cada uno con su precio, su estado y, opcionalmente, un
/// precio promocional desde `minIntegrantes` (spec 029). Cada integrante lleva el tipo del plan que eligió.
model Delegacion {
  id                          Int                 @id @default(autoincrement())
  eventoId                    Int                 @map("evento_id")
  nombre                      String
  codigoLink                  String              @unique(map: "uq_delegaciones_codigo_link") @map("codigo_link") @db.VarChar(100)
  institucion                 String?
  representanteNombre         String?             @map("representante_nombre")
  representanteEmail          String?             @map("representante_email")
  representanteTelefono       String?             @map("representante_telefono")
  /// Documento del delegado (spec 023): es el contacto del grupo, no necesariamente un integrante.
  representanteTipoDocumento  String?             @map("representante_tipo_documento") @db.VarChar(10)
  representanteDocumento      String?             @map("representante_documento") @db.VarChar(20)
  /// Integrantes activos desde los que los planes con precio promocional lo cobran (spec 029).
  minIntegrantes              Int                 @default(10) @map("min_integrantes")
  /// Dominio permitido para el correo de los integrantes que se inscriben por link (p. ej. `unac.edu.pe`, sin
  /// arroba). `null` = cualquiera. El staff queda exento.
  dominioCorreo               String?             @map("dominio_correo") @db.VarChar(100)
  /// Link individual (spec 029): con él cada integrante se inscribe solo. `null` = apagado.
  codigoInscripcion           String?             @unique(map: "uq_delegaciones_codigo_inscripcion") @map("codigo_inscripcion") @db.VarChar(100)
  activo                      Boolean             @default(true)
  creadoEn                    DateTime            @default(now()) @map("creado_en")
  actualizadoEn               DateTime            @updatedAt @map("actualizado_en")
  evento                      Evento              @relation(fields: [eventoId], references: [id], onDelete: Cascade, map: "fk_delegaciones_evento")
  /// Categoría oculta con los planes de la delegación (spec 029).
  planes                      CategoriaInscripcion? @relation("PlanesDeDelegacion")
  inscripciones               Inscripcion[]
  pagos                       DelegacionPago[]

  @@index([eventoId], map: "idx_delegaciones_evento")
  @@map("delegaciones")
}

enum EstadoPagoDelegacion {
  PENDIENTE
  VERIFICADO
  RECHAZADO
}

/// Un voucher de una delegación (spec 023). Una delegación puede pagar en varias partes: cada una
/// con su archivo, su número de operación y el monto que declara el delegado.
model DelegacionPago {
  id               Int                  @id @default(autoincrement())
  delegacionId     Int                  @map("delegacion_id")
  /// Denormalizado para que el número de operación sea único por evento.
  eventoId         Int                  @map("evento_id")
  modalidadPago    String               @map("modalidad_pago") @db.VarChar(40)
  banco            String?              @db.VarChar(40)
  billeteraDigital String?              @map("billetera_digital") @db.VarChar(40)
  tipoOperacion    String?              @map("tipo_operacion") @db.VarChar(40)
  numeroOperacion  String               @map("numero_operacion") @db.VarChar(100)
  fechaPago        DateTime             @map("fecha_pago")
  /// Lo que dice el voucher; el staff lo contrasta con el estado de cuenta.
  monto            Decimal              @db.Decimal(10, 2)
  voucherArchivo   String               @map("voucher_archivo")
  estado           EstadoPagoDelegacion @default(PENDIENTE)
  motivoRechazo    String?              @map("motivo_rechazo") @db.VarChar(500)
  revisadoPorId    Int?                 @map("revisado_por_id")
  revisadoEn       DateTime?            @map("revisado_en")
  creadoEn         DateTime             @default(now()) @map("creado_en")
  delegacion       Delegacion           @relation(fields: [delegacionId], references: [id], onDelete: Cascade, map: "fk_delegacion_pagos_delegacion")
  revisadoPor      Administrador?       @relation("DelegacionPagoRevisor", fields: [revisadoPorId], references: [id], onDelete: SetNull, map: "fk_delegacion_pagos_revisado_por")

  @@unique([eventoId, numeroOperacion], map: "uq_delegacion_pagos_evento_numero_operacion")
  @@index([delegacionId], map: "idx_delegacion_pagos_delegacion")
  @@index([revisadoPorId], map: "idx_delegacion_pagos_revisado_por")
  @@map("delegacion_pagos")
}

// ─── Seguimiento por asesor (spec 025) ───────────────────────────────────────

/// Docente que acompaña a una o más secciones de estudiantes (spec 025). El nombre se guarda tal como
/// lo escribe la facultad en su Excel («DRA. ANGOMA ASTUCURI MIRIAM»); no es una cuenta del panel.
model Asesor {
  id            Int             @id @default(autoincrement())
  eventoId      Int             @map("evento_id")
  nombre        String          @db.VarChar(200)
  /// DNI del docente (spec 028), de 8 dígitos. Con él entra a la página común de consulta; `null` = sin DNI.
  documento     String?         @db.VarChar(20)
  /// Enlace público del docente (spec 026): token aleatorio de 43 caracteres (256 bits) con el que el docente ve
  /// el avance de sus estudiantes sin iniciar sesión. `null` = sin enlace (nunca se creó o se desactivó).
  enlaceToken        String?   @unique(map: "uq_asesores_enlace_token") @map("enlace_token") @db.VarChar(64)
  enlaceCreadoEn     DateTime? @map("enlace_creado_en")
  /// Última vez que el docente abrió su enlace (se actualiza como máximo cada 5 minutos).
  enlaceUltimoAcceso DateTime? @map("enlace_ultimo_acceso")
  /// `id_docente` de SIVIRENO (spec 034): el docente de los cursos de la programación académica. Con él sus alumnos son los
  /// matriculados en **sus** cursos; sin él (agregado a mano o del Excel) el docente atiende secciones. `null` = no viene de SIVIRENO.
  jpDocenteId   Int?            @map("jp_docente_id")
  creadoEn      DateTime        @default(now()) @map("creado_en")
  actualizadoEn DateTime        @updatedAt @map("actualizado_en")
  evento        Evento          @relation(fields: [eventoId], references: [id], onDelete: Cascade, map: "fk_asesores_evento")
  secciones     AsesorSeccion[]
  cursos        PadronCurso[]

  @@unique([eventoId, nombre], map: "uq_asesores_evento_nombre")
  @@unique([eventoId, documento], map: "uq_asesores_evento_documento")
  @@unique([eventoId, jpDocenteId], map: "uq_asesores_evento_jp_docente")
  @@map("asesores")
}

/// Ciclo y sección que atiende un asesor (spec 025). Una sección puede tener varios asesores.
model AsesorSeccion {
  asesorId Int    @map("asesor_id")
  /// Denormalizado para buscar los asesores de una sección sin pasar por `asesores`.
  eventoId Int    @map("evento_id")
  ciclo    String @db.VarChar(10)
  seccion  String @db.VarChar(10)
  asesor   Asesor @relation(fields: [asesorId], references: [id], onDelete: Cascade, map: "fk_asesores_secciones_asesor")

  @@id([asesorId, ciclo, seccion])
  @@index([eventoId, ciclo, seccion], map: "idx_asesores_secciones_evento_seccion")
  @@map("asesores_secciones")
}

/// Estudiante del padrón de un semestre que sigue cada asesor (spec 025). Lo carga la facultad con su
/// Excel; el pago **no** se guarda aquí: se cruza en cada consulta con las inscripciones del evento.
model PadronEstudiante {
  id           Int      @id @default(autoincrement())
  eventoId     Int      @map("evento_id")
  /// Semestre académico del padrón («2026-2»).
  semestre     String   @db.VarChar(10)
  documento    String   @db.VarChar(20)
  codigo       String   @db.VarChar(20)
  correo       String?  @db.VarChar(191)
  /// «APELLIDOS NOMBRES» tal como viene del Excel (no se separa).
  nombre       String   @db.VarChar(200)
  celular      String?  @db.VarChar(20)
  carrera      String   @db.VarChar(120)
  ciclo        String   @db.VarChar(10)
  turno        String?  @db.VarChar(5)
  seccion      String   @db.VarChar(10)
  distrito     String?  @db.VarChar(80)
  provincia    String?  @db.VarChar(80)
  departamento String?  @db.VarChar(80)
  creadoEn     DateTime @default(now()) @map("creado_en")
  evento       Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade, map: "fk_padron_estudiantes_evento")
  /// Todas las secciones en que cursa (spec 033). `ciclo`, `turno` y `seccion` de arriba son solo la principal.
  secciones    PadronSeccion[]
  /// Los cursos de SIVIRENO en que está matriculado (spec 034); vacío si el padrón viene solo del Excel.
  matriculas   PadronMatricula[]

  @@unique([eventoId, codigo], map: "uq_padron_estudiantes_evento_codigo")
  @@index([eventoId, ciclo, seccion], map: "idx_padron_estudiantes_evento_seccion")
  @@index([eventoId, documento], map: "idx_padron_estudiantes_evento_documento")
  @@map("padron_estudiantes")
}

/// Ciclo y sección (grupo de asesoría) en que cursa un estudiante del padrón (spec 033). La sección va ligada al curso:
/// un alumno puede estar en varias (teoría y laboratorio, o un curso repetido de otro ciclo). `cursos` es cuántos lleva ahí.
/// Se borra en cascada con el estudiante: el padrón se reemplaza entero en cada carga.
model PadronSeccion {
  eventoId   Int              @map("evento_id")
  codigo     String           @db.VarChar(20)
  ciclo      String           @db.VarChar(10)
  seccion    String           @db.VarChar(10)
  turno      String?          @db.VarChar(5)
  cursos     Int              @default(1)
  estudiante PadronEstudiante @relation(fields: [eventoId, codigo], references: [eventoId, codigo], onDelete: Cascade, map: "fk_padron_secciones_estudiante")

  @@id([eventoId, codigo, ciclo, seccion])
  @@index([eventoId, ciclo, seccion], map: "idx_padron_secciones_evento_seccion")
  @@map("padron_secciones")
}

/// Curso de la programación académica de SIVIRENO (spec 034): una carga lectiva = asignatura + ciclo + sección + turno + docente.
/// Lo carga `npm run padron:desde-jp` desde JP y se reemplaza entero en cada carga. Los alumnos de un curso son sus `matriculas`.
model PadronCurso {
  id            Int               @id @default(autoincrement())
  eventoId      Int               @map("evento_id")
  /// `id_carga_lectiva` de SIVIRENO: es lo que identifica al curso allá.
  jpCargaId     Int               @map("jp_carga_id")
  /// Código de la asignatura («ISES240601»).
  codigo        String            @db.VarChar(30)
  nombre        String            @db.VarChar(200)
  ciclo         String            @db.VarChar(10)
  turno         String?           @db.VarChar(5)
  seccion       String            @db.VarChar(10)
  /// Docente del curso (un `Asesor` con su `jp_docente_id`); `null` si se borró.
  asesorId      Int?              @map("asesor_id")
  /// Nombre del docente tal como lo escribe SIVIRENO.
  docenteNombre String?           @map("docente_nombre") @db.VarChar(200)
  evento        Evento            @relation(fields: [eventoId], references: [id], onDelete: Cascade, map: "fk_padron_cursos_evento")
  asesor        Asesor?           @relation(fields: [asesorId], references: [id], onDelete: SetNull, map: "fk_padron_cursos_asesor")
  matriculas    PadronMatricula[]

  @@unique([eventoId, jpCargaId], map: "uq_padron_cursos_evento_carga")
  @@index([eventoId, ciclo, seccion], map: "idx_padron_cursos_evento_seccion")
  @@index([asesorId], map: "idx_padron_cursos_asesor")
  @@map("padron_cursos")
}

/// Un estudiante del padrón matriculado en un curso de SIVIRENO (spec 034). Se borra en cascada con el estudiante y con el curso.
model PadronMatricula {
  eventoId   Int              @map("evento_id")
  codigo     String           @db.VarChar(20)
  cursoId    Int              @map("curso_id")
  estudiante PadronEstudiante @relation(fields: [eventoId, codigo], references: [eventoId, codigo], onDelete: Cascade, map: "fk_padron_matriculas_estudiante")
  curso      PadronCurso      @relation(fields: [cursoId], references: [id], onDelete: Cascade, map: "fk_padron_matriculas_curso")

  @@id([eventoId, codigo, cursoId])
  @@index([cursoId], map: "idx_padron_matriculas_curso")
  @@map("padron_matriculas")
}

/// Enlace público de un ciclo (spec 027): token aleatorio de 43 caracteres (256 bits) con el que quien lo recibe
/// ve el avance de pagos de todos los estudiantes de ese ciclo sin iniciar sesión. Vive aparte del padrón (que se
/// reemplaza en cada carga) para que recargarlo no invalide los enlaces ya entregados. El ciclo se guarda
/// tal como viene en el padrón («VI»).
model EnlaceCiclo {
  id           Int       @id @default(autoincrement())
  eventoId     Int       @map("evento_id")
  ciclo        String    @db.VarChar(10)
  token        String    @unique(map: "uq_enlaces_ciclo_token") @db.VarChar(64)
  creadoEn     DateTime  @default(now()) @map("creado_en")
  /// Última vez que se abrió el enlace (se actualiza como máximo cada 5 minutos).
  ultimoAcceso DateTime? @map("ultimo_acceso")
  evento       Evento    @relation(fields: [eventoId], references: [id], onDelete: Cascade, map: "fk_enlaces_ciclo_evento")

  @@unique([eventoId, ciclo], map: "uq_enlaces_ciclo_evento_ciclo")
  @@map("enlaces_ciclo")
}

/// Enlace público del aforo de las ponencias especializadas (spec 036): uno por evento. Con su token (43 caracteres,
/// 256 bits) la landing del evento muestra, sin iniciar sesión, el aforo, los inscritos presenciales y la asistencia de
/// cada tema; nunca datos de personas. Solo el Owner lo crea, renueva o desactiva.
model EnlaceAforoPonencias {
  id           Int       @id @default(autoincrement())
  eventoId     Int       @unique(map: "uq_enlaces_aforo_ponencias_evento") @map("evento_id")
  token        String    @unique(map: "uq_enlaces_aforo_ponencias_token") @db.VarChar(64)
  creadoEn     DateTime  @default(now()) @map("creado_en")
  /// Última vez que se abrió el enlace (se actualiza como máximo cada 5 minutos).
  ultimoAcceso DateTime? @map("ultimo_acceso")
  evento       Evento    @relation(fields: [eventoId], references: [id], onDelete: Cascade, map: "fk_enlaces_aforo_ponencias_evento")

  @@map("enlaces_aforo_ponencias")
}

// ─── Actividades y asistencia ────────────────────────────────────────────────

model Actividad {
  id          Int          @id @default(autoincrement())
  eventoId    Int          @map("evento_id")
  nombre      String       @db.VarChar(150)
  fecha       DateTime
  horaInicio  DateTime     @map("hora_inicio")
  horaFin     DateTime     @map("hora_fin")
  evento      Evento       @relation(fields: [eventoId], references: [id], map: "fk_actividades_evento")
  asistencias Asistencia[]

  @@index([eventoId], map: "idx_actividades_evento")
  @@map("actividades")
}

/// Cómo se registró una asistencia (spec 013). NULL en las filas anteriores.
enum MetodoAsistencia {
  QR
  QR_LEGADO
  DOCUMENTO
  MANUAL
}

/// Una fila por participante y actividad. La anulación es lógica: volver a marcar reactiva la fila.
model Asistencia {
  id               Int               @id @default(autoincrement())
  registradoEn     DateTime          @default(now()) @map("registrado_en")
  participanteId   Int               @map("participante_id")
  actividadId      Int               @map("actividad_id")
  metodo           MetodoAsistencia?
  registradoPorId  Int?              @map("registrado_por_id")
  esFueraDeHorario Boolean           @default(false) @map("es_fuera_de_horario")
  anuladoEn        DateTime?         @map("anulado_en")
  anuladoPorId     Int?              @map("anulado_por_id")
  actividad        Actividad         @relation(fields: [actividadId], references: [id], map: "fk_asistencias_actividad")
  participante     Participante      @relation(fields: [participanteId], references: [id], map: "fk_asistencias_participante")
  registradoPor    Administrador?    @relation("AsistenciaRegistradaPor", fields: [registradoPorId], references: [id], onDelete: SetNull, map: "fk_asistencias_registrado_por")
  anuladoPor       Administrador?    @relation("AsistenciaAnuladaPor", fields: [anuladoPorId], references: [id], onDelete: SetNull, map: "fk_asistencias_anulado_por")

  @@unique([participanteId, actividadId], map: "uq_asistencias_participante_actividad")
  @@index([actividadId], map: "idx_asistencias_actividad")
  @@index([registradoPorId], map: "idx_asistencias_registrado_por")
  @@index([anuladoPorId], map: "idx_asistencias_anulado_por")
  @@map("asistencias")
}

// ─── Ponencias y contacto ────────────────────────────────────────────────────

model Ponencia {
  id              String   @id @db.VarChar(36)
  eventoId        Int      @map("evento_id")
  titulo          String   @db.VarChar(300)
  autorPrincipal  Json     @map("autor_principal")
  coautores       Json
  archivo         String   @db.VarChar(255)
  archivoOriginal String   @map("archivo_original") @db.VarChar(255)
  tamanoBytes     Int      @map("tamano_bytes")
  creadoEn        DateTime @default(now()) @map("creado_en")
  evento          Evento   @relation(fields: [eventoId], references: [id], map: "fk_ponencias_evento")

  @@index([eventoId, creadoEn], map: "idx_ponencias_evento_creado")
  @@map("ponencias")
}

// ─── Ponencias especializadas (spec 019) ─────────────────────────────────────

enum ModalidadPonencia {
  PRESENCIAL
  VIRTUAL
}

enum ProcedenciaAsistente {
  INTERNO
  EXTERNO
}

enum EstadoInscripcionPonencia {
  INSCRITO
  CANCELADO
}

enum OrigenInscripcionPonencia {
  LANDING
  STAFF
  PUERTA
}

enum MotivoCancelacionPonencia {
  STAFF
  CAMBIO_EN_PUERTA
  /// El staff la canceló porque la persona no está inscrita al congreso con el pago aprobado (spec 031)
  SIN_CONGRESO
}

/// Ponencia especializada del evento (no es la `Ponencia` del Call for Papers). La duración se deriva de
/// `horaInicio`/`horaFin`; `precio` 0 = gratuita; `cupo` NULL = sin límite. El ponente va embebido y, si el tema lo
/// comparten varios (misma hora y ambiente), los demás van en `coponentes`.
model PonenciaEspecializada {
  id             Int                   @id @default(autoincrement())
  eventoId       Int                   @map("evento_id")
  tema           String                @db.VarChar(300)
  fecha          DateTime              @db.Date
  horaInicio     DateTime              @map("hora_inicio")
  horaFin        DateTime              @map("hora_fin")
  ambiente       String                @db.VarChar(120)
  modalidad      ModalidadPonencia     @default(PRESENCIAL)
  precio         Decimal               @default(0) @db.Decimal(10, 2)
  cupo           Int?
  ponenteNombre  String                @map("ponente_nombre") @db.VarChar(200)
  ponenteBio     String?               @map("ponente_bio") @db.Text
  /// Ruta relativa de la landing (`/images/...`) o URL https
  ponenteFoto    String?               @map("ponente_foto") @db.VarChar(255)
  ponenteExterno Boolean               @default(false) @map("ponente_externo")
  /// Ponentes que comparten el tema además del principal (spec 032): `[{ nombre, bio, foto, externo }]`, hasta 3.
  /// NULL = el tema lo dicta una sola persona. Solo se muestran: no se consultan ni se unen a nada.
  coponentes     Json?
  /// Visible e inscribible desde la landing; el staff puede inscribir igual
  publicada      Boolean               @default(true)
  orden          Int                   @default(0)
  creadoEn       DateTime              @default(now()) @map("creado_en")
  actualizadoEn  DateTime              @updatedAt @map("actualizado_en")
  evento         Evento                @relation(fields: [eventoId], references: [id], map: "fk_ponencias_especializadas_evento")
  inscripciones  InscripcionPonencia[]

  @@index([eventoId, fecha, horaInicio], map: "idx_ponencias_especializadas_evento_fecha")
  @@map("ponencias_especializadas")
}

/// Persona que asiste a ponencias especializadas, identificada por su documento. Correo y celular son
/// opcionales (a diferencia de `Participante`).
model AsistentePonencia {
  id              Int                   @id @default(autoincrement())
  tipoDocumentoId String                @map("tipo_documento_id")
  numeroDocumento String                @map("numero_documento") @db.VarChar(20)
  nombres         String                @db.VarChar(120)
  apellidos       String                @db.VarChar(120)
  correo          String?               @db.VarChar(191)
  celular         String?               @db.VarChar(20)
  procedencia     ProcedenciaAsistente?
  creadoEn        DateTime              @default(now()) @map("creado_en")
  actualizadoEn   DateTime              @updatedAt @map("actualizado_en")
  tipoDocumento   TipoDocumento         @relation(fields: [tipoDocumentoId], references: [id], map: "fk_asistentes_ponencia_tipo_documento")
  inscripciones   InscripcionPonencia[]

  @@unique([tipoDocumentoId, numeroDocumento], map: "uq_asistentes_ponencia_documento")
  @@map("asistentes_ponencia")
}

/// Inscripción de un asistente a una ponencia. La asistencia vive en la misma fila (una ponencia es una sola
/// sesión): `asistioEn` NULL = aún no asistió.
model InscripcionPonencia {
  id                Int                        @id @default(autoincrement())
  ponenciaId        Int                        @map("ponencia_id")
  asistenteId       Int                        @map("asistente_id")
  estado            EstadoInscripcionPonencia  @default(INSCRITO)
  origen            OrigenInscripcionPonencia
  registradoPorId   Int?                       @map("registrado_por_id")
  asistioEn         DateTime?                  @map("asistio_en")
  asistenciaPorId   Int?                       @map("asistencia_por_id")
  esFueraDeHorario  Boolean                    @default(false) @map("es_fuera_de_horario")
  canceladoEn       DateTime?                  @map("cancelado_en")
  motivoCancelacion MotivoCancelacionPonencia? @map("motivo_cancelacion")
  /// Inscripción aprobada al congreso con la que se validó (spec 030). NULL = sin validar (acceso libre o
  /// inscripciones anteriores a la validación).
  inscripcionCongresoId Int?                   @map("inscripcion_congreso_id")
  /// Cómo asiste a la ponencia, según su inscripción al congreso. Solo la presencial ocupa aforo.
  modoAsistencia    ModalidadAsistencia        @default(PRESENCIAL) @map("modo_asistencia")
  /// Cuándo se le envió el comunicado desde el panel (cancelación o aviso previo, spec 031). NULL = sin avisar.
  avisoEnviadoEn    DateTime?                  @map("aviso_enviado_en")
  creadoEn          DateTime                   @default(now()) @map("creado_en")
  actualizadoEn     DateTime                   @updatedAt @map("actualizado_en")
  ponencia          PonenciaEspecializada      @relation(fields: [ponenciaId], references: [id], map: "fk_inscripciones_ponencia_ponencia")
  asistente         AsistentePonencia          @relation(fields: [asistenteId], references: [id], map: "fk_inscripciones_ponencia_asistente")
  inscripcionCongreso Inscripcion?             @relation(fields: [inscripcionCongresoId], references: [id], onDelete: SetNull, map: "fk_inscripciones_ponencia_congreso")
  registradoPor     Administrador?             @relation("InscripcionPonenciaRegistradaPor", fields: [registradoPorId], references: [id], onDelete: SetNull, map: "fk_inscripciones_ponencia_registrado_por")
  asistenciaPor     Administrador?             @relation("InscripcionPonenciaAsistenciaPor", fields: [asistenciaPorId], references: [id], onDelete: SetNull, map: "fk_inscripciones_ponencia_asistencia_por")

  @@unique([ponenciaId, asistenteId], map: "uq_inscripciones_ponencia_asistente")
  @@index([asistenteId], map: "idx_inscripciones_ponencia_asistente")
  @@index([registradoPorId], map: "idx_inscripciones_ponencia_registrado_por")
  @@index([asistenciaPorId], map: "idx_inscripciones_ponencia_asistencia_por")
  @@index([inscripcionCongresoId], map: "idx_inscripciones_ponencia_congreso")
  @@index([ponenciaId, estado, modoAsistencia], map: "idx_inscripciones_ponencia_cupo")
  @@map("inscripciones_ponencia")
}

model MensajeContacto {
  id        Int      @id @default(autoincrement())
  eventoId  Int?     @map("evento_id")
  nombres   String
  apellidos String
  correo    String
  asunto    String
  mensaje   String   @db.Text
  leido     Boolean  @default(false)
  creadoEn  DateTime @default(now()) @map("creado_en")
  evento    Evento?  @relation(fields: [eventoId], references: [id], onDelete: SetNull, map: "fk_mensajes_contacto_evento")

  @@index([eventoId], map: "idx_mensajes_contacto_evento")
  @@map("mensajes_contacto")
}

// ─── Consultas de documentos (spec 003) ──────────────────────────────────────

enum ProveedorConsulta {
  DECOLECTA
  APIPERU
}

enum PeriodoRenovacion {
  DIARIO
  MENSUAL
  ANUAL
  NINGUNO
}

enum EstadoTokenConsulta {
  ACTIVO
  AGOTADO
  INVALIDO
}

enum ResultadoConsulta {
  EXITO
  NO_ENCONTRADO
  AGOTADO
  TOKEN_INVALIDO
  ERROR
  CACHE
  SIN_TOKENS
}

enum OrigenConsulta {
  LANDING
  PANEL
  SISTEMA
}

model TokenConsulta {
  id                Int                 @id @default(autoincrement())
  proveedor         ProveedorConsulta
  nombre            String              @db.VarChar(100)
  tokenCifrado      String              @map("token_cifrado") @db.Text
  tokenSufijo       String              @map("token_sufijo") @db.VarChar(8)
  limiteConsultas   Int?                @map("limite_consultas")
  consultasUsadas   Int                 @default(0) @map("consultas_usadas")
  periodoRenovacion PeriodoRenovacion   @default(MENSUAL) @map("periodo_renovacion")
  fechaRenovacion   DateTime?           @map("fecha_renovacion")
  prioridad         Int                 @default(100)
  estado            EstadoTokenConsulta @default(ACTIVO)
  activo            Boolean             @default(true)
  ultimoError       String?             @map("ultimo_error") @db.VarChar(500)
  ultimoUsoEn       DateTime?           @map("ultimo_uso_en")
  agotadoEn         DateTime?           @map("agotado_en")
  creadoEn          DateTime            @default(now()) @map("creado_en")
  actualizadoEn     DateTime            @updatedAt @map("actualizado_en")
  consultas         ConsultaDocumento[]

  @@index([activo, estado, prioridad], map: "idx_tokens_consulta_seleccion")
  @@map("tokens_consulta")
}

model ConsultaDocumento {
  id              Int                @id @default(autoincrement())
  tokenConsultaId Int?               @map("token_consulta_id")
  proveedor       ProveedorConsulta?
  tipoDocumento   String             @default("dni") @map("tipo_documento") @db.VarChar(10)
  numeroMascara   String             @map("numero_mascara") @db.VarChar(20)
  resultado       ResultadoConsulta
  codigoHttp      Int?               @map("codigo_http")
  duracionMs      Int?               @map("duracion_ms")
  origen          OrigenConsulta
  detalle         String?            @db.VarChar(300)
  creadoEn        DateTime           @default(now()) @map("creado_en")
  token           TokenConsulta?     @relation(fields: [tokenConsultaId], references: [id], onDelete: SetNull, map: "fk_consultas_documento_token")

  @@index([creadoEn], map: "idx_consultas_documento_creado")
  @@index([tokenConsultaId, creadoEn], map: "idx_consultas_documento_token_creado")
  @@map("consultas_documento")
}

model PersonaConsultada {
  id              Int               @id @default(autoincrement())
  tipoDocumento   String            @default("dni") @map("tipo_documento") @db.VarChar(10)
  numeroDocumento String            @map("numero_documento") @db.VarChar(20)
  nombres         String            @db.VarChar(120)
  apellidoPaterno String            @map("apellido_paterno") @db.VarChar(120)
  apellidoMaterno String            @map("apellido_materno") @db.VarChar(120)
  proveedor       ProveedorConsulta
  consultadoEn    DateTime          @default(now()) @map("consultado_en")

  @@unique([tipoDocumento, numeroDocumento], map: "uq_personas_consultadas_documento")
  @@map("personas_consultadas")
}

// ─── Integraciones (spec 005) ────────────────────────────────────────────────

enum TipoIntegracion {
  DEPORTES_FI
}

enum EstadoIntegracion {
  OK
  ERROR
}

model IntegracionEvento {
  id                     Int                @id @default(autoincrement())
  eventoId               Int                @map("evento_id")
  tipo                   TipoIntegracion
  nombre                 String             @db.VarChar(120)
  urlBase                String             @map("url_base") @db.VarChar(255)
  tokenCifrado           String             @map("token_cifrado") @db.Text
  tokenSufijo            String             @map("token_sufijo") @db.VarChar(8)
  activo                 Boolean            @default(true)
  ultimoEstado           EstadoIntegracion? @map("ultimo_estado")
  ultimoError            String?            @map("ultimo_error") @db.VarChar(500)
  ultimaSincronizacionEn DateTime?          @map("ultima_sincronizacion_en")
  creadoEn               DateTime           @default(now()) @map("creado_en")
  actualizadoEn          DateTime           @updatedAt @map("actualizado_en")
  evento                 Evento             @relation(fields: [eventoId], references: [id], onDelete: Cascade, map: "fk_integraciones_evento_evento")

  @@index([eventoId], map: "idx_integraciones_evento_evento")
  @@map("integraciones_evento")
}

// ─── Correo saliente (spec 006) ──────────────────────────────────────────────

enum ProveedorCorreo {
  BREVO
  /// SMTP de Gmail (smtp.gmail.com:465, SSL) con una contraseña de aplicación (spec 041).
  GMAIL_SMTP
}

/// Credencial de envío de correo (API key de Brevo o contraseña de aplicación de Gmail, cifrada con
/// AES-256-GCM). Cada evento puede elegir una; si no, se usa la predeterminada. Si el envío falla,
/// se prueban las demás activas por `prioridad` (spec 041).
model CredencialCorreo {
  id               Int                @id @default(autoincrement())
  proveedor        ProveedorCorreo    @default(BREVO)
  nombre           String             @db.VarChar(120)
  apiKeyCifrada    String             @map("api_key_cifrada") @db.Text
  apiKeySufijo     String             @map("api_key_sufijo") @db.VarChar(8)
  remitenteCorreo  String             @map("remitente_correo") @db.VarChar(191)
  remitenteNombre  String?            @map("remitente_nombre") @db.VarChar(120)
  esPredeterminada Boolean            @default(false) @map("es_predeterminada")
  /// Orden de respaldo (menor = antes; la predeterminada va primero sin importar su valor). PUT /order la renumera 1, 2, 3… (spec 041).
  prioridad        Int                @default(0)
  /// Envíos que le quedan en Brevo según su API (`/account`); NULL = no se sabe o no aplica (Gmail). Se actualiza al probar, al revisar y antes de enviar si pasaron más de 5 min (spec 042).
  creditos         Int?               @map("creditos_disponibles")
  creditosEn       DateTime?          @map("creditos_verificados_en")
  activo           Boolean            @default(true)
  ultimoEstado     EstadoIntegracion? @map("ultimo_estado")
  ultimoError      String?            @map("ultimo_error") @db.VarChar(500)
  ultimaPruebaEn   DateTime?          @map("ultima_prueba_en")
  ultimoEnvioEn    DateTime?          @map("ultimo_envio_en")
  creadoEn         DateTime           @default(now()) @map("creado_en")
  actualizadoEn    DateTime           @updatedAt @map("actualizado_en")
  eventos          Evento[]

  @@map("credenciales_correo")
}

// ─── Tokens de acceso del sitio de cada evento (spec 007) ─────────────────────

/// Token con el que la landing de un evento consume la API del sitio (`/v1/site/*`).
/// Solo se guarda su hash (SHA-256); el valor se muestra una única vez al crearlo.
model TokenAcceso {
  id            Int            @id @default(autoincrement())
  eventoId      Int            @map("evento_id")
  nombre        String         @db.VarChar(120)
  prefijo       String         @unique(map: "uq_tokens_acceso_prefijo") @db.VarChar(24)
  tokenHash     String         @unique(map: "uq_tokens_acceso_token_hash") @map("token_hash") @db.Char(64)
  ultimoUsoEn   DateTime?      @map("ultimo_uso_en")
  expiraEn      DateTime?      @map("expira_en")
  revocadoEn    DateTime?      @map("revocado_en")
  creadoPorId   Int?           @map("creado_por_id")
  creadoEn      DateTime       @default(now()) @map("creado_en")
  actualizadoEn DateTime       @updatedAt @map("actualizado_en")
  evento        Evento         @relation(fields: [eventoId], references: [id], onDelete: Cascade, map: "fk_tokens_acceso_evento")
  creadoPor     Administrador? @relation(fields: [creadoPorId], references: [id], onDelete: SetNull, map: "fk_tokens_acceso_creado_por")

  @@index([eventoId], map: "idx_tokens_acceso_evento")
  @@index([creadoPorId], map: "idx_tokens_acceso_creado_por")
  @@map("tokens_acceso")
}

// ─── Configuración del sistema (spec 008) ────────────────────────────────────

/// Configuración global de fila única (id = 1). Reemplaza variables de entorno: API_UNDC
/// (URL, API key cifrada con AES-256-GCM, timeout), Google (client ID), URL del panel y el
/// interruptor de las rutas de la landing anterior.
model ConfiguracionSistema {
  id                 Int                @id @default(1)
  undcApiUrl         String?            @map("undc_api_url") @db.VarChar(255)
  undcApiKeyCifrada  String?            @map("undc_api_key_cifrada") @db.Text
  undcApiKeySufijo   String?            @map("undc_api_key_sufijo") @db.VarChar(8)
  undcApiTimeoutMs   Int                @default(8000) @map("undc_api_timeout_ms")
  undcUltimoEstado   EstadoIntegracion? @map("undc_ultimo_estado")
  undcUltimoError    String?            @map("undc_ultimo_error") @db.VarChar(500)
  undcUltimaPruebaEn DateTime?          @map("undc_ultima_prueba_en")
  googleClientId     String?            @map("google_client_id") @db.VarChar(255)
  urlPanel           String?            @map("url_panel") @db.VarChar(255)
  urlLanding         String?            @map("url_landing") @db.VarChar(255)
  rutasLegacyActivas Boolean            @default(true) @map("rutas_legacy_activas")
  actualizadoPorId   Int?               @map("actualizado_por_id")
  creadoEn           DateTime           @default(now()) @map("creado_en")
  actualizadoEn      DateTime           @updatedAt @map("actualizado_en")
  actualizadoPor     Administrador?     @relation(fields: [actualizadoPorId], references: [id], onDelete: SetNull, map: "fk_configuracion_sistema_actualizado_por")

  @@index([actualizadoPorId], map: "idx_configuracion_sistema_actualizado_por")
  @@map("configuracion_sistema")
}
