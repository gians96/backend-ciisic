PORT=3000
NODE_ENV=development
DATABASE_URL=mysql://user:password@localhost:3306/ciisic
SHADOW_DATABASE_URL=mysql://user:password@localhost:3306/ciisic_shadow
JWT_SECRET=replace-with-at-least-32-random-characters
# Orígenes de navegador (landing anterior). Admite comodines: https://*.episundc.pe
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
UPLOADS_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# Cifrado de secretos (tokens DNI, credenciales de correo, integraciones) y hash de los tokens
# de acceso de cada evento. OBLIGATORIA en producción; si cambia, hay que volver a cargar los
# secretos y regenerar los tokens de acceso.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY=

# Consultas de DNI (los tokens de Decolecta/apiperu se registran desde el panel)
DNI_CACHE_TTL_DAYS=30
DNI_LOOKUP_TIMEOUT_MS=8000

# Verificación de estudiantes UNDC (API_UNDC, API key con scope estudiantes:verificar)
UNDC_API_URL=https://api-jp.episundc.pe
UNDC_API_KEY=
UNDC_API_TIMEOUT_MS=8000
# Opcional: secreto para firmar el token de verificación (por defecto se deriva de JWT_SECRET)
VERIFICACION_SECRET=
VERIFICACION_TTL_HORAS=24

# Integraciones por evento (deportes-fi). Lista opcional de hosts permitidos.
INTEGRATIONS_ALLOWED_HOSTS=
INTEGRATIONS_TIMEOUT_MS=10000

# Correo: la API key de Brevo y el remitente se gestionan en el panel (Correo) y se guardan
# cifrados en la BD. Opcional: BREVO_API_URL=https://api.brevo.com/v3, EMAIL_TIMEOUT_MS=15000
# Transición desde la versión anterior: si al arrancar existen DECOLECTA_TOKEN o
# BREVO_API_KEY + BREVO_SENDER (+ BREVO_SENDER_NAME) y las tablas están vacías, se importan a la
# BD una sola vez; después se eliminan del entorno.

# Rutas de la landing anterior (/v1/inscription, /v1/registration-types, …). Poner en false
# cuando la landing nueva (API del sitio con token por evento) esté en producción.
LEGACY_ROUTES_ENABLED=true

# Docker: el contenedor aplica `prisma migrate deploy` al iniciar (false para omitirlo)
# MIGRATE_ON_START=true

# Ruta de Chromium para generar credenciales PDF (en Docker: /usr/bin/chromium)
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Solo para ejecutar manualmente npm run bootstrap:admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_ADMIN_NAMES=Administrador
BOOTSTRAP_ADMIN_SURNAMES=CIISIC
