PORT=3000
NODE_ENV=development
DATABASE_URL=mysql://user:password@localhost:3306/ciisic
SHADOW_DATABASE_URL=mysql://user:password@localhost:3306/ciisic_shadow
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
UPLOADS_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# Cifrado de secretos salientes (tokens DNI e integraciones). OBLIGATORIA en producción.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY=

# Consultas de DNI (los tokens de Decolecta/apiperu se registran desde el panel)
DNI_CACHE_TTL_DAYS=30
DNI_LOOKUP_TIMEOUT_MS=8000

# Verificación de estudiantes UNDC (API_UNDC, API key con scope estudiantes:verificar)
UNDC_API_URL=https://api-jp.episundc.pe
UNDC_API_KEY=
UNDC_API_TIMEOUT_MS=8000
# Opcional: secreto para firmar el token de verificación (por defecto se deriva de JWT_SECRET)
VERIFICACION_SECRET=
VERIFICACION_TTL_HORAS=24

# Integraciones por evento (deportes-fi). Lista opcional de hosts permitidos.
INTEGRATIONS_ALLOWED_HOSTS=
INTEGRATIONS_TIMEOUT_MS=10000

# Correo (Brevo). El remitente y asunto se pueden definir por evento desde el panel.
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER=no-reply@example.com
BREVO_SENDER_NAME=
BREVO_SENDER_SUBJECT=Inscripción aprobada

# Ruta de Chromium para generar credenciales PDF (en Docker: /usr/bin/chromium)
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Solo para ejecutar manualmente npm run bootstrap:admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_ADMIN_NAMES=Administrador
BOOTSTRAP_ADMIN_SURNAMES=CIISIC
