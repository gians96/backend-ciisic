# ─────────────────────────────────────────────────────────────────────────────
# backend-ciisic · variables de entorno (spec 008)
# Solo lo que no puede vivir en la base de datos. Todo lo demás se configura en el panel:
#   Sistema        → API_UNDC (URL, API key, timeout), Google (client ID), URL del panel,
#                    rutas de la landing anterior
#   Correo         → credenciales de Brevo
#   Consultas DNI  → tokens de Decolecta / apiperu
#   Eventos→Acceso → tokens de acceso de cada landing
# ─────────────────────────────────────────────────────────────────────────────

DATABASE_URL=mysql://user:password@localhost:3306/ciisic

# Firma de las sesiones. Mínimo 32 caracteres aleatorios; cambiarlo cierra las sesiones.
JWT_SECRET=replace-with-at-least-32-random-characters

# Cifra los secretos guardados en la BD y el hash de los tokens de acceso. OBLIGATORIA en
# producción y NO debe cambiar (si cambia, hay que volver a cargar secretos y tokens).
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY=

# Opcional (3000 por defecto)
# PORT=3000

# Solo desarrollo: base de datos temporal para `prisma migrate dev`
# SHADOW_DATABASE_URL=mysql://user:password@localhost:3306/ciisic_shadow

# Solo desarrollo en Windows/macOS: Chrome local para generar credenciales PDF
# (la imagen Docker ya trae Chromium)
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
